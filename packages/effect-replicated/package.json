{
  "name": "effect-replicated",
  "version": "0.0.0",
  "description": "Experimental: Effect services whose fields are state-based CRDTs, replicated over any Effect RPC protocol.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egriff38/effect-iroh.git",
    "directory": "packages/effect-replicated"
  },
  "keywords": ["effect", "effect-ts", "crdt", "replication", "local-first", "atoms"],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "effect": "catalog:prod"
  },
  "devDependencies": {
    "effect": "catalog:prod",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev"
  }
}
